.RData
.Rhistory
.Rproj.user/
*.Rproj
.Ruserdata
# NOTE: *.rds is NOT blanket-excluded because processed analysis data in
# Blind Version/reproducibility_materials/data_application/data/processed/
# are small (< 350KB each) and enable the fast-route workflow.
# Exclude only specific large/internal rds files:
Simulation/Sim Multiple Case 1/results/*.rds
Simulation/*/results/mc_raw_*.rds

