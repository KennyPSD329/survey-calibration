# it accidentally matched simulation/results/ (the public release folder).
# The rerun_outputs exclusion below handles the only subfolder that needs excluding.

# ----- Raw data not to be redistributed via GitHub ---------------------------
# NHIS / NHANES raw public-use files — users should download from CDC/NCHS:
Blind Version/reproducibility_materials/data_application/data/raw/nhis/nhis_2003_2004.csv
Blind Version/reproducibility_materials/data_application/data/raw/mortality/

# ----- Supplementary code with machine-specific absolute paths ---------------
Blind Version/reproducibility_materials/data_application/supplementary_code/

# ----- Reproducibility archive artifacts (named as do-not-include in README) -
Blind Version/reproducibility_materials/simulation/archive_not_for_submission/
Blind Version/reproducibility_materials/simulation/results/rerun_outputs/
Blind Version/reproducibility_materials/simulation/results/Original result file/

# ----- R workspaces in simulation subdirectories ----------------------------
Simulation/.RData

# ----- Public release folders: generated/optional outputs (not needed for fast route) ---
simulation/results/rerun_outputs/

# ----- Public release folders: raw data (users download from CDC/NCHS) ----------
application/data/raw/nhanes/
application/data/raw/nhis/
application/data/raw/mortality/

